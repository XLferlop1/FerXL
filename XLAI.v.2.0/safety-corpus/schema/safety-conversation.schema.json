{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xlai.local/safety-corpus/schema/safety-conversation.schema.json",
  "title": "XLAI Safety Corpus Multi-Turn Conversation",
  "description": "A versioned multi-turn safety corpus conversation. Trajectory, recipient perspective, and user factors support evaluation and coaching design only; they are not safety enforcement mechanisms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "corpusVersion", "conversationMetadata", "turns", "safetyAnnotation", "expectedBehavior", "cumulativeState", "safetyTransitions", "communicationPattern", "annotationMeta"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^xlai-conversation-[0-9]{6,}$"
    },
    "schemaVersion": { "const": "0.1.3" },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "safetyAnnotation": { "$ref": "#/$defs/safetyAnnotation" },
    "expectedBehavior": { "$ref": "#/$defs/expectedBehavior" },
    "conversationMetadata": { "$ref": "#/$defs/conversationMetadata" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/turn" }
    },
    "cumulativeState": { "$ref": "#/$defs/cumulativeState" },
    "safetyTransitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/safetyTransition" },
      "description": "An empty array represents a conversation with no recorded safety-level transition."
    },
    "communicationPattern": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidencePattern" },
      "description": "Flexible interaction-level patterns; each pattern requires evidence and does not determine safety level."
    },
    "recipientPerspective": { "$ref": "#/$defs/recipientPerspective" },
    "trajectory": { "$ref": "#/$defs/trajectory" },
    "userFactors": { "$ref": "#/$defs/userFactors" },
    "behavioralContext": { "$ref": "#/$defs/behavioralContext" },
    "coachingOpportunity": { "$ref": "#/$defs/coachingOpportunity" },
    "annotationMeta": { "$ref": "#/$defs/annotationMeta" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableUnknownString": {
      "type": ["string", "null"],
      "description": "Use null or unknown when the conversation does not establish a value."
    },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "safetyCategory": {
      "type": "string",
      "enum": ["none", "emotional_distress", "conflict_crisis", "unsafe_relationship_dynamics", "abuse_or_coercion", "stalking_or_tracking", "threats_or_intimidation", "coercive_control_or_isolation", "home_danger", "self_harm_or_suicide", "violence_risk", "immediate_danger"]
    },
    "safetyAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": { "$ref": "#/$defs/safetyCategory" },
        "level": { "type": "integer", "minimum": 0, "maximum": 5 },
        "urgency": { "type": "string", "enum": ["none", "monitor", "elevated", "high", "immediate"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "semanticSignals": { "$ref": "#/$defs/stringArray" },
        "expectedDeterministicSignals": { "$ref": "#/$defs/stringArray" },
        "importantAbsentSignals": { "$ref": "#/$defs/stringArray" },
        "annotationRationale": { "$ref": "#/$defs/nonEmptyString" },
        "annotationCertainty": {
          "type": "string",
          "enum": ["clear", "uncertain", "ambiguous"],
          "description": "Certainty of this specific turn annotation, not numeric classifier confidence. It may differ from final conversation-level annotation certainty after all turns are considered."
        }
      },
      "description": "Optional per-turn annotation; an unknown turn need not have a full safety annotation. When present, annotationCertainty describes the specific turn; the conversation-level annotationCertainty reflects the complete available conversation."
    },
    "communicationRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "evidence"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "evidence": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "conversationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "enum": ["messaging", "coach", "journal", "unknown"] },
        "contextType": { "$ref": "#/$defs/nullableUnknownString" },
        "relationship": { "$ref": "#/$defs/nullableUnknownString" },
        "conversationGoal": { "$ref": "#/$defs/nullableUnknownString" },
        "startingSafetyLevel": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 }
      }
    },
    "evidenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "evidence"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "value": {},
        "evidence": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnNumber", "speaker", "text"],
      "properties": {
        "turnNumber": { "type": "integer", "minimum": 1 },
        "speaker": { "type": "string", "enum": ["user", "other", "system", "unknown"] },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/evidenceObservation" } },
        "safetyAnnotation": { "$ref": "#/$defs/safetyAnnotation" },
        "communicationRisks": { "type": "array", "items": { "$ref": "#/$defs/communicationRisk" } }
      }
    },
    "cumulativeState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentSafetyCategory": { "$ref": "#/$defs/safetyCategory" },
        "currentSafetyLevel": { "type": ["integer", "null"], "minimum": 0, "maximum": 5 },
        "emotionalDirection": { "$ref": "#/$defs/nullableUnknownString" },
        "conflictDirection": { "$ref": "#/$defs/nullableUnknownString" },
        "knownFacts": { "type": "array", "items": { "$ref": "#/$defs/evidenceObservation" } },
        "importantUnknowns": { "$ref": "#/$defs/stringArray" }
      }
    },
    "safetyTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromLevel", "toLevel", "atTurn", "reason", "evidence"],
      "properties": {
        "fromLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
        "toLevel": { "type": "integer", "minimum": 0, "maximum": 5 },
        "atTurn": { "type": "integer", "minimum": 1 },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/stringArray" }
      }
    },
    "evidencePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "evidence"],
      "properties": {
        "pattern": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/stringArray" }
      }
    },
    "recipientPerspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["possibleInterpretations", "possibleEmotionalResponses", "possibleNeedsOrConcerns", "confidence", "evidence", "unknowns"],
      "properties": {
        "possibleInterpretations": { "$ref": "#/$defs/stringArray" },
        "possibleEmotionalResponses": { "$ref": "#/$defs/stringArray" },
        "possibleNeedsOrConcerns": { "$ref": "#/$defs/stringArray" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "$ref": "#/$defs/stringArray" },
        "unknowns": { "$ref": "#/$defs/stringArray" }
      },
      "description": "Possible recipient interpretations only; never factual mind-reading or diagnostic labeling."
    },
    "trajectoryOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "likelihood", "confidence", "evidence", "increasingFactors", "decreasingFactors"],
      "properties": {
        "outcome": { "$ref": "#/$defs/nonEmptyString" },
        "likelihood": { "type": "string", "enum": ["low", "moderate", "high", "unknown"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "$ref": "#/$defs/stringArray" },
        "increasingFactors": { "$ref": "#/$defs/stringArray" },
        "decreasingFactors": { "$ref": "#/$defs/stringArray" }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["possibleOutcomes"],
      "properties": {
        "currentDirection": { "$ref": "#/$defs/nullableUnknownString" },
        "possibleOutcomes": { "type": "array", "items": { "$ref": "#/$defs/trajectoryOutcome" } }
      },
      "description": "Multiple plausible future outcomes with evidence and confidence; not a safety enforcement decision."
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "evidence"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/nonEmptyString" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "description": "An interaction-level observation, not a permanent or diagnostic personality label."
    },
    "userFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strengths", "vulnerabilityFactors"],
      "properties": {
        "strengths": { "type": "array", "items": { "$ref": "#/$defs/factor" } },
        "vulnerabilityFactors": { "type": "array", "items": { "$ref": "#/$defs/factor" } }
      }
    },
    "behavioralContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineStatus", "observedPatterns", "recurringThemes", "baselineDeviations", "interactionLoops", "contextualModifiers"],
      "properties": {
        "baselineStatus": { "type": "string", "enum": ["observed", "insufficient_evidence", "unknown"] },
        "observedPatterns": { "type": "array", "items": { "$ref": "#/$defs/factor" } },
        "recurringThemes": { "type": "array", "items": { "$ref": "#/$defs/factor" } },
        "baselineDeviations": { "type": "array", "items": { "$ref": "#/$defs/factor" } },
        "interactionLoops": { "type": "array", "items": { "$ref": "#/$defs/factor" } },
        "contextualModifiers": { "type": "array", "items": { "$ref": "#/$defs/factor" } }
      },
      "description": "Evidence-bound interaction context, never a psychological profile or permanent user model. Omit when prior evidence is insufficient."
    },
    "expectedBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shouldStopNormalCoaching", "allowNormalSend", "allowRewriteApply", "useSafetyGuidance", "showSafetyResources"],
      "properties": {
        "shouldStopNormalCoaching": { "type": "boolean" },
        "allowNormalSend": { "type": "boolean" },
        "allowRewriteApply": { "type": "boolean" },
        "useSafetyGuidance": { "type": "boolean" },
        "showSafetyResources": { "type": "boolean" }
      },
      "description": "Expected outcomes for evaluation, derived from the authoritative Safety Knowledge Base and not a second policy source."
    },
    "coachingOpportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryGoal", "recommendedStrategy", "reason", "avoid", "userControllableFactors"],
      "properties": {
        "primaryGoal": { "$ref": "#/$defs/nonEmptyString" },
        "recommendedStrategy": { "$ref": "#/$defs/nonEmptyString", "description": "Flexible strategy label; no closed taxonomy is established here." },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "avoid": { "$ref": "#/$defs/stringArray" },
        "userControllableFactors": { "$ref": "#/$defs/stringArray" }
      },
      "description": "Strategy metadata only; do not include a generated coaching message."
    },
    "annotationMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "creationMethod", "reviewStatus", "annotationCertainty", "annotationNotes", "provenance"],
      "properties": {
        "source": { "type": "string", "enum": ["synthetic", "curated", "public_research_derived", "licensed", "deidentified_real_world", "internal_evaluation"] },
        "creationMethod": { "$ref": "#/$defs/nonEmptyString" },
        "reviewStatus": {
          "type": "string",
          "enum": ["draft", "reviewed", "gold"],
          "description": "Review quality status. It is independent from annotation certainty; gold does not imply clear."
        },
        "annotationCertainty": {
          "type": "string",
          "enum": ["clear", "uncertain", "ambiguous"],
          "description": "Evidence certainty status, not model confidence. A gold record may be ambiguous when that ambiguity is explicitly reviewed."
        },
        "annotationNotes": { "$ref": "#/$defs/stringArray" },
        "provenance": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
