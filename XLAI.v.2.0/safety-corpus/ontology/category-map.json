      "knowledgeBaseReference": "engine/safetyKnowledgeBase.js#SAFETY_CATEGORIES.self_harm_or_suicide",
      "annotationDescription": "Possible self-harm, suicidal intent, or a desire not to live is indicated."
    },
    {
      "key": "violence_risk",
      "safetyLevel": 4,
      "canonicalLabel": "violence risk",
      "knowledgeBaseReference": "engine/safetyKnowledgeBase.js#SAFETY_CATEGORIES.violence_risk",
      "annotationDescription": "Possible intent or risk of physically harming another person is indicated."
    },
    {
      "key": "immediate_danger",
      "safetyLevel": 5,
      "canonicalLabel": "immediate danger",
      "knowledgeBaseReference": "engine/safetyKnowledgeBase.js#SAFETY_CATEGORIES.immediate_danger",
